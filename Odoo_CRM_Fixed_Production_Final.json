    {
      "parameters": {
        "jsCode": "const lead = $('Code - Format & Validate Data').first().json;\nconst raw = $input.first().json?.message?.content\n          || $input.first().json?.choices?.[0]?.message?.content\n          || $input.first().json?.text || '{}';\nlet ai;\ntry {\n  ai = JSON.parse(raw.replace(/```json|```/gi, '').trim());\n} catch(e) {\n  ai = { score: 50, category: 'Warm', reason: 'AI parse failed - default assigned' };\n}\nconst score    = Math.min(100, Math.max(0, parseInt(ai.score) || 50));\nconst category = score >= 70 ? 'Hot' : score >= 50 ? 'Warm' : 'Cold';\nconst reason   = ai.reason || 'No reason provided';\n\nconst salesReps = [\n  { name: 'Nazish Jahan', phone: 'whatsapp:+923116004886', email: 'nazishjahan22@gmail.com', role: 'Senior', odooId: 9 },\n  { name: 'Mehran Ali',   phone: 'whatsapp:+923007045809', email: 'aliawan8694@gmail.com',   role: 'Junior', odooId: 8 }\n];\n\nconst assignedRep = score >= 70\n  ? salesReps.find(r => r.role === 'Senior')\n  : salesReps.find(r => r.role === 'Junior');\n\nconst assignedTier  = score >= 70 ? 'Senior Sales Rep' : score >= 50 ? 'Junior Sales Rep' : 'Email Nurture';\nconst responseTime  = score >= 70 ? '1 hour' : score >= 50 ? '24 hours' : 'Automated';\nconst odooPriority  = score >= 70 ? '2' : score >= 50 ? '1' : '0';\n\nconst odooDescription = `AI Score: ${score}/100 | Category: ${category}\\nReason: ${reason}\\nRequirement: ${lead.requirement}\\nBudget: Rs. ${lead.budget}\\nTimeline: ${lead.timeline}\\nDecision Maker: ${lead.isDecisionMaker}\\nSource: ${lead.source}\\nAssigned To: ${assignedRep?.name} (${assignedTier})\\nResponse Time: ${responseTime}\\nSubmitted: ${lead.submittedAt}`;\n\nreturn [{ json: {\n  fullName:         lead.fullName,\n  email:            lead.email,\n  phone:            lead.phone,\n  company:          lead.company,\n  budget:           lead.budget,\n  requirement:      lead.requirement,\n  timeline:         lead.timeline,\n  timelineDays:     lead.timelineDays,\n  isDecisionMaker:  lead.isDecisionMaker,\n  source:           lead.source,\n  submittedAt:      lead.submittedAt,\n  aiScore:          score,\n  aiCategory:       category,\n  aiReason:         reason,\n  odooDescription,\n  odooUserId:       assignedRep?.odooId || 9,\n  assignedTier,\n  assignedRepName:  assignedRep?.name  || 'Team Lead',\n  assignedRepPhone: assignedRep?.phone || 'whatsapp:+923116004886',\n  assignedRepEmail: assignedRep?.email || 'nazishjahan22@gmail.com',\n  responseTime,\n  odooPriority\n} }];"
      },
