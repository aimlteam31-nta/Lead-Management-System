    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4o Mini"
        },
        "messages": {
          "values": [
            {
              "content": "You are a B2B lead scoring expert. Always respond with valid JSON only. No markdown. No explanation. Just the JSON object.",
              "role": "system"
            },
            {
              "content": "=Score this lead 0-100. Return ONLY valid JSON: {\"score\": 75, \"category\": \"Warm\", \"reason\": \"short reason\"}\n\nScoring (100 pts total):\n- Budget (0-25): Rs. {{ $json.budget }} — 500k+=25pts, 100k+=20pts, 50k+=15pts, 10k+=10pts, below=5pts\n- Timeline urgency (0-25): {{ $json.timelineDays }} days — 1day=25pts, 7days=20pts, 14days=15pts, 30days=10pts, 90days=5pts\n- Requirement detail (0-20): {{ $json.requirement }} — specific=20pts, vague=10pts\n- Company size (0-15): {{ $json.company }} — large=15pts, medium=10pts, small=5pts\n- Decision maker (0-15): {{ $json.isDecisionMaker }} — Yes=15pts, No=0pts\n\nRules: 70-100=Hot, 50-69=Warm, 0-49=Cold\n\nBe honest in reason. Mention actual budget. Do not call low budget strong."
            }
          ]
        },
        "options": {
          "maxTokens": 150,
          "temperature": 0.1
        }
      },
      "id": "30fd2117-c476-4ca2-97ee-939850ee7d2e",
      "name": "OpenAI - AI Lead Scoring",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1216,
        624
