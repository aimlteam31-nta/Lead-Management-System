{
  "name": "Odoo_CRM_Fixed_Production_Final",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook - Receive Lead').first().json;\nconst body = webhookData.body || webhookData;\nconst trim = (v) => (v ? String(v).trim() : '');\nfunction normalizePhone(phone) {\n  let p = trim(phone).replace(/\\s+/g, '').replace(/-/g, '');\n  if (p.startsWith('0')) p = '+92' + p.slice(1);\n  if (!p.startsWith('+')) p = '+92' + p;\n  return p;\n}\nfunction timelineToDays(tl) {\n  const t = trim(tl).toLowerCase();\n  if (t.includes('today') || t.includes('urgent') || t.includes('asap')) return 1;\n  if (t.includes('this week') || t.includes('3 day') || t.includes('few day')) return 7;\n  if (t.includes('next week') || t.includes('2 week')) return 14;\n  if (t.includes('this month') || t.includes('month')) return 30;\n  if (t.includes('next month')) return 60;\n  return 90;\n}\nfunction parseBudget(b) {\n  if (!b) return 0;\n  return parseFloat(String(b).replace(/[^0-9.]/g, '')) || 0;\n}\nconst fullName        = trim(body.full_name || body.fullName || body.name || '');\nconst email           = trim(body.email || '').toLowerCase();\nconst phone           = normalizePhone(body.phone || body.phone_number || '');\nconst company         = trim(body.company || body.company_name || '');\nconst budget          = parseBudget(body.budget);\nconst requirement     = trim(body.requirement || body.message || '');\nconst timeline        = trim(body.timeline || '');\nconst timelineDays    = timelineToDays(timeline);\nconst decRaw          = trim(body.decision_maker || body.is_decision_maker || 'no').toLowerCase();\nconst isDecisionMaker = (decRaw === 'yes' || decRaw === 'true' || decRaw === '1');\nconst source          = trim(body.source || body.how_did_you_find_us || 'Direct');\nconst submittedAt     = new Date().toISOString();\nif (!fullName) throw new Error('Validation: full_name required');\nif (!email || !email.includes('@')) throw new Error('Validation: valid email required');\nif (!phone || phone.length < 10) throw new Error('Validation: valid phone required');\nreturn [{ json: { fullName, email, phone, company, budget, requirement, timeline, timelineDays, isDecisionMaker, source, submittedAt } }];"
      },
      "id": "0ba6bf55-3a81-4178-adba-e3a9147da14d",
      "name": "Code - Format & Validate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
